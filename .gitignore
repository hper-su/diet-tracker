# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ローカル動作確認時に溜まった実行ログ
/.dev-run-now*.log
/.dev-server*.log
/.prod-*.log
/.serve-run.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database (個人の食事・体組成データ)
/data/*.db
/data/*.db-journal
/data/*.db-shm
/data/*.db-wal

# 個人の食事・体組成データを含むエクスポート/インポート用ファイル
/diet-tracker-export.json
